---
import { render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import TOC from '../../components/blog/TOC.astro';
import FAQAccordion from '../../components/shared/FAQAccordion.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { resolvePublishedRelated } from '../../lib/related';
import { articleSchema, faqPageSchema, breadcrumbListSchema, isRealDate } from '../../lib/schema';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublished('blog');
  return posts.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const hub = await getEntry('blogHub', 'blog');
const categoriaNombre = hub?.data.categorias.find((c) => c.slug === entry.data.categoria)?.nombre ?? entry.data.categoria;

const relacionados = (
  await Promise.all(entry.data.relacionados.map((slug: string) => resolvePublishedRelated('blog', slug)))
).filter(Boolean);

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
  { name: categoriaNombre, url: `/blog#${entry.data.categoria}` },
  { name: entry.data.title, url: `/blog/${entry.data.slug}` },
];

const jsonLd = [
  articleSchema({
    headline: entry.data.title,
    description: entry.data.meta_description,
    url: `https://eynes.com.ar/blog/${entry.data.slug}`,
    datePublished: isRealDate(entry.data.fecha_publicacion) ? entry.data.fecha_publicacion : undefined,
    dateModified: isRealDate(entry.data.fecha_actualizacion) ? entry.data.fecha_actualizacion : undefined,
    author: entry.data.autor,
  }),
  faqPageSchema(entry.data.faqs),
  breadcrumbListSchema(crumbs),
].filter(Boolean) as Record<string, unknown>[];
---

<BaseLayout title={entry.data.seo_title} description={entry.data.meta_description} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />

  <article class="section">
    <div class="container-page reveal grid gap-10 lg:grid-cols-[1fr_260px]">
      <div class="min-w-0">
        <p class="kicker">{categoriaNombre}</p>
        <h1 class="mt-3 text-3xl sm:text-4xl">{entry.data.title}</h1>
        <p class="mt-3 flex flex-wrap gap-x-3 font-mono text-xs uppercase tracking-wide text-ink-faint">
          {entry.data.autor && <span>Por {entry.data.autor}</span>}
          {isRealDate(entry.data.fecha_publicacion) && <span>· {entry.data.fecha_publicacion}</span>}
          <span>· {entry.data.tiempo_lectura_min} min de lectura</span>
        </p>

        <div class="prose-content mt-8">
          <Content />
        </div>

        <div class="mt-10 border-t pt-6" style="border-color: var(--color-line)">
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=https://eynes.com.ar/blog/${entry.data.slug}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline"
          >
            Compartir en LinkedIn
          </a>
        </div>

        {
          relacionados.length > 0 && (
            <div class="mt-10">
              <h2 class="text-xl font-semibold text-ink">Notas relacionadas</h2>
              <div class="mt-4 grid gap-4 sm:grid-cols-2">
                {relacionados.map((post) => (
                  <a href={withBase(`/blog/${post!.data.slug}`)} class="card block">
                    <p class="font-medium text-ink">{post!.data.title}</p>
                  </a>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="hidden lg:block">
        <TOC headings={headings} />
      </aside>
    </div>
  </article>

  <FAQAccordion faqs={entry.data.faqs} title="Preguntas frecuentes" />

  <CTASection heading="¿Querés ver esto funcionando en tu empresa?" primaryLabel="Agendar demo" />
</BaseLayout>
