---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import FilterBar from '../../components/blog/FilterBar.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { blogSchema, breadcrumbListSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';

const hub = await getEntry('blogHub', 'blog');
const posts = (await getPublished('blog')).sort((a, b) =>
  b.data.fecha_publicacion > a.data.fecha_publicacion ? 1 : -1
);

const categoriaNombre = (slug: string) =>
  hub?.data.categorias.find((c) => c.slug === slug)?.nombre ?? slug;

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Blog', url: '/blog' },
];

const jsonLd = hub
  ? [
      blogSchema(),
      { name: hub.data.title, description: hub.data.meta_description },
      breadcrumbListSchema(crumbs),
    ]
  : [];
---

<BaseLayout title={hub?.data.seo_title ?? 'Blog'} description={hub?.data.meta_description ?? ''} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />
  <Hero title={hub?.data.title ?? 'Recursos y novedades'} showPartnerBadge={false} compact />

  <section class="section">
    <div class="container-page reveal">
      {hub && <FilterBar categorias={hub.data.categorias} />}

      {
        posts.length === 0 && (
          <p class="rounded-md border border-dashed border-line p-10 text-center text-ink-faint">
            Ya estamos preparando las primeras notas. Mientras tanto, {' '}
            <a href={withBase('/demo')} class="font-medium text-teal hover:underline">agendá una demo</a>.
          </p>
        )
      }

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          posts.map((post) => (
            <a
              href={withBase(`/blog/${post.data.slug}`)}
              class="card block"
              data-post-card
              data-category={post.data.categoria}
              data-title={post.data.title}
            >
              <p class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">
                {categoriaNombre(post.data.categoria)}
              </p>
              <p class="mt-2 font-semibold text-ink">{post.data.title}</p>
              <p class="mt-3 font-mono text-xs text-ink-faint">{post.data.tiempo_lectura_min} min de lectura</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection heading="¿Querés ver esto funcionando en tu empresa?" primaryLabel="Agendar demo" />
</BaseLayout>
