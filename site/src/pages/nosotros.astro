---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import CollaboratorMap from '../components/shared/CollaboratorMap.astro';
import {
  aboutPageSchema,
  organizationSchema,
  localBusinessSchema,
  breadcrumbListSchema,
} from '../lib/schema';

const page = await getEntry('paginasUnicas', 'nosotros');
const site = await getEntry('siteConfig', 'site');
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;

const team = [
  { name: 'Laureano Kloss', role: 'Director Ejecutivo', image: `${base}images/equipo/laureano.webp` },
  { name: 'Analía Gómez Benítez', role: 'Directora de Administración', image: `${base}images/equipo/analia.webp` },
  { name: 'Santiago Said', role: 'Director Técnico', image: `${base}images/equipo/santiago.webp` },
  { name: 'Patricia Avendaño', role: 'Directora de Proyectos', image: `${base}images/equipo/patricia.webp` },
];

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Nosotros', url: '/nosotros' },
];

const jsonLd = site
  ? [
      aboutPageSchema(),
      organizationSchema(site.data),
      ...site.data.oficinas.map((office) => localBusinessSchema(office)),
      breadcrumbListSchema(crumbs),
    ]
  : [];
---

<BaseLayout title={page?.data.seo_title ?? ''} description={page?.data.meta_description ?? ''} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />
  <Hero understated
    title={page?.data.title ?? ''}
    showPartnerBadge={false}
    compact
  />

  <section class="section">
    <div class="container-page reveal">
      <h2 class="mt-2 text-2xl sm:text-3xl">Nuestro equipo</h2>
      <div class="team-grid mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {team.map((person) => (
          <div class="card bg-paper text-center">
            <img src={person.image} alt={`Foto de ${person.name}`} class="mx-auto h-20 w-20 rounded-full object-cover" width="80" height="80" loading="lazy" />
            <p class="mt-4 font-semibold text-ink">{person.name}</p>
            <p class="text-sm text-ink-faint">{person.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {
    site && (
      <section class="section bg-paper-dim">
        <div class="container-page reveal">
          <h2 class="mt-2 text-2xl sm:text-3xl">Un equipo distribuido en dos países</h2>
          <p class="mt-3 max-w-2xl text-ink-soft">La implementación y el soporte se construyen con personas que trabajan desde distintas provincias de Argentina y desde España.</p>
          <div class="mt-8">
            <CollaboratorMap ubicaciones={site.data.equipo.ubicaciones} cantidadPersonas={site.data.equipo.cantidad_personas} />
          </div>
        </div>
      </section>
    )
  }

  {
    site && (
      <section class="section">
        <div class="container-page reveal">
          <h2 class="mt-2 text-2xl sm:text-3xl">Oficinas y zonas de cobertura</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {site.data.oficinas.map((office) => (
              <div class="card">
                <p class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">Sede</p>
                <p class="mt-3 font-semibold text-ink">{office.ciudad}, {office.pais}</p>
                <p class="mt-1 text-sm text-ink-soft">{office.direccion}</p>
                <p class="mt-1 text-sm text-ink-soft">{office.telefono}</p>
              </div>
            ))}
            {site.data.zonas_de_cobertura.map((zona) => (
              <div class="card">
                <p class="font-mono text-xs font-semibold uppercase tracking-wide text-ink-faint">Atención remota</p>
                <p class="mt-3 font-semibold text-ink">{zona.ciudad}, {zona.pais}</p>
                <p class="mt-1 text-sm text-ink-soft">{zona.telefono}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-paper-dim" aria-labelledby="como-trabajamos">
    <div class="container-page reveal">
      <h2 id="como-trabajamos">Cómo trabajamos</h2>
      <div class="work-grid">
        <div>
          <span class="work-step" aria-hidden="true">1</span>
          <h3>Entendemos tu operación</h3>
          <p>Conversamos con tu equipo para conocer los procesos, las dificultades y lo que necesitás resolver con Odoo.</p>
        </div>
        <div>
          <span class="work-step" aria-hidden="true">2</span>
          <h3>Definimos e implementamos</h3>
          <p>Acordamos el alcance y las prioridades del proyecto. Configuramos los módulos y trabajamos con tu equipo en la puesta en marcha.</p>
        </div>
        <div>
          <span class="work-step" aria-hidden="true">3</span>
          <h3>Te acompañamos</h3>
          <p>Después de la implementación, seguimos cerca para resolver consultas y acompañar los cambios de tu operación.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section join-team" aria-labelledby="forma-parte">
    <div class="container-page reveal">
      <h2 id="forma-parte">Forma parte</h2>
      <ol class="join-steps">
        <li>
          <span class="join-step" aria-hidden="true">01</span>
          <h3>Enviá tu CV</h3>
          <a href="mailto:bienestarhumano@eynes.com.ar">bienestarhumano@eynes.com.ar</a>
        </li>
        <li>
          <span class="join-step" aria-hidden="true">02</span>
          <h3>Agendá una entrevista con Bienestar Humano</h3>
        </li>
        <li>
          <span class="join-step" aria-hidden="true">03</span>
          <h3>Agendá una entrevista con el director de área</h3>
        </li>
        <li>
          <span class="join-step" aria-hidden="true">04</span>
          <h3>Ya estás a bordo</h3>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .work-grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 32px; }
  .work-grid > div { position: relative; padding-top: 8px; }
  .work-grid > div:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 26px;
    left: 100%;
    width: 32px;
    height: 1.5px;
    background: var(--color-line);
  }
  .work-step {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 20px;
    border-radius: var(--radius-pill);
    background: var(--color-dark);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .work-grid h3 { font-size: 1.125rem; font-weight: 500; line-height: 1.4; letter-spacing: -0.02em; }
  .work-grid p { margin-top: 12px; font-size: 0.9375rem; line-height: 1.75; color: var(--color-ink-soft); }
  @media (max-width: 639px) {
    .work-grid { grid-template-columns: 1fr; gap: 28px; }
    .work-grid > div::after { display: none; }
  }

  .join-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-top: 36px;
    list-style: none;
    padding: 0;
  }
  .join-steps li { border-top: 1px solid var(--color-line); padding-top: 20px; }
  .join-step { display: block; margin-bottom: 16px; font-family: var(--font-mono); font-size: 0.875rem; color: var(--color-teal); }
  .join-steps h3 { font-size: 1.0625rem; font-weight: 500; line-height: 1.5; letter-spacing: -0.015em; text-wrap: initial; }
  .join-steps a { display: inline-block; margin-top: 8px; font-size: 0.875rem; color: var(--color-purple); overflow-wrap: anywhere; }
  .join-steps a:hover { text-decoration: underline; }
  @media (max-width: 1023px) { .join-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 639px) { .join-steps { grid-template-columns: 1fr; gap: 24px; } }
</style>
