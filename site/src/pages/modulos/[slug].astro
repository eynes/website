---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ContentSection from '../../components/shared/ContentSection.astro';
import FAQAccordion from '../../components/shared/FAQAccordion.astro';
import CTASection from '../../components/cta/CTASection.astro';
import ModuleIcon from '../../components/shared/ModuleIcon.astro';
import { getPublished } from '../../lib/content';
import { splitSections, renderSection, extractLabeled } from '../../lib/sections';
import { resolvePublishedRelated } from '../../lib/related';
import { productSchema, faqPageSchema, breadcrumbListSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';
import { getModuleIcon } from '../../lib/moduleIcons';

export async function getStaticPaths() {
  const modulos = await getPublished('modulos');
  return modulos.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? '');

const subtitle = extractLabeled(sections['01']?.body, 'Subtítulo');
const featuresHtml = await renderSection(sections, '02');

const integrados = (
  await Promise.all(entry.data.modulos_integrados.map((slug: string) => resolvePublishedRelated('modulos', slug)))
).filter(Boolean);

const casoRelacionado = entry.data.caso_relacionado?.slug
  ? await resolvePublishedRelated('casosDeExito', entry.data.caso_relacionado.slug)
  : null;

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Módulos', url: '/modulos' },
  { name: entry.data.title, url: `/modulos/${entry.data.slug}` },
];

const jsonLd = [
  productSchema({
    name: entry.data.title,
    description: entry.data.meta_description,
    url: `https://eynes.com.ar/modulos/${entry.data.slug}`,
  }),
  faqPageSchema(entry.data.faqs),
  breadcrumbListSchema(crumbs),
].filter(Boolean) as Record<string, unknown>[];

const { accent } = getModuleIcon(entry.data.slug);
---

<BaseLayout title={entry.data.seo_title} description={entry.data.meta_description} jsonLd={jsonLd}>
  <div class="module-page" style={`--accent: ${accent}`}>
    <Breadcrumbs crumbs={crumbs} />
    <Hero understated title={entry.data.title} subtitle={subtitle} showPartnerBadge={false}>
      <div slot="details" class="mb-2">
        <span class="module-hero-icon">
          <ModuleIcon slug={entry.data.slug} />
        </span>
      </div>
    </Hero>

    <ContentSection number="02" title="Features con impacto" html={featuresHtml} />

    {
      (integrados.length > 0 || casoRelacionado) && (
        <section class="section bg-paper-dim">
          <div class="container-page reveal grid gap-8 sm:grid-cols-2">
            {integrados.length > 0 && (
              <div>
                <h2 class="text-xl font-semibold text-ink">Se integra con</h2>
                <div class="mt-4 flex flex-wrap gap-3">
                  {integrados.map((m) => (
                    <a href={withBase(`/modulos/${m!.data.slug}`)} class="module-pill">
                      {m!.data.title}
                    </a>
                  ))}
                </div>
              </div>
            )}
            {casoRelacionado && (
              <div>
                <h2 class="text-xl font-semibold text-ink">Resultado real</h2>
                <a href={withBase(`/casos/${casoRelacionado.data.slug}`)} class="card module-result-card mt-4 block bg-paper">
                  <p class="font-semibold text-ink">{casoRelacionado.data.cliente}</p>
                  <p class="mt-2 text-sm text-ink-soft">{entry.data.caso_relacionado?.resultado}</p>
                </a>
              </div>
            )}
          </div>
        </section>
      )
    }

    <FAQAccordion faqs={entry.data.faqs} title="Preguntas frecuentes del módulo" />

    <CTASection heading="Quiero ver este módulo en acción" />
  </div>
</BaseLayout>
