---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { collectionPageSchema, breadcrumbListSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';

const hub = await getEntry('verticalesHub', 'verticales');
const verticales = await getPublished('verticales');

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Verticales', url: '/verticales' },
];

const jsonLd = hub
  ? [
      collectionPageSchema(
        hub.data.title,
        hub.data.meta_description,
        verticales.map((v) => `https://eynes.com.ar/verticales/${v.data.slug}`)
      ),
      breadcrumbListSchema(crumbs),
    ]
  : [];
---

<BaseLayout title={hub?.data.seo_title ?? ''} description={hub?.data.meta_description ?? ''} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />
  <Hero title={hub?.data.title ?? ''} subtitle="Odoo se adapta a cada industria — cada rubro tiene sus propios problemas y su propia solución." showPartnerBadge={false} compact />

  <nav aria-label="Agrupadores de rubros" class="container-page flex flex-wrap gap-3 py-6">
    {[...new Set(verticales.map(v => v.data.agrupador))].map((group, i) => (
      <a href={`#grupo-${i}`} class="rounded-full border border-line px-4 py-2 text-sm text-teal hover:bg-paper-dim">{group}</a>
    ))}
  </nav>
  {[...new Set(verticales.map(v => v.data.agrupador))].map((group, i) => (
    <section id={`grupo-${i}`} class="section scroll-mt-24">
      <div class="container-page">
        <h2 class="mb-6 text-2xl">{group}</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {verticales.filter(v => v.data.agrupador === group).map(v => (
            <a href={withBase(`/verticales/${v.data.slug}`)} class="card block">
              <h3 class="font-semibold text-ink">{v.data.title}</h3>
              <p class="mt-2 text-sm text-ink-soft">{v.data.casos_relacionados.length} {v.data.casos_relacionados.length === 1 ? 'empresa' : 'empresas'} en este rubro</p>
              <span class="mt-4 inline-block text-sm font-medium text-teal">Ver problemas y soluciones →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <CTASection heading="¿No encontrás tu rubro? Contanos tu caso igual" />
</BaseLayout>
