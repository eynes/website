---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { collectionPageSchema, breadcrumbListSchema } from '../../lib/schema';
import { withBase } from '../../lib/url';

const hub = await getEntry('verticalesHub', 'verticales');
const verticales = await getPublished('verticales');

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Sectores', url: '/sectores' },
];

const jsonLd = hub
  ? [
      collectionPageSchema(
        hub.data.title,
        hub.data.meta_description,
        verticales.map((v) => `https://eynes.com.ar/sectores/${v.data.slug}`)
      ),
      breadcrumbListSchema(crumbs),
    ]
  : [];

const groups = [...new Set(verticales.map((v) => v.data.agrupador))].map((group) => ({
  nombre: group,
  items: verticales.filter((v) => v.data.agrupador === group),
}));

const colorClasses = ['text-teal', 'text-purple', 'text-silver', 'text-purple-light'];
---

<BaseLayout title={hub?.data.seo_title ?? ''} description={hub?.data.meta_description ?? ''} jsonLd={jsonLd}>
  <Hero understated title="Sectores" showPartnerBadge={false} compact />

  <section class="section sector-columns-section">
    <div class="container-page">
      <div class="sector-columns">
        {groups.map((group, i) => (
          <div class="sector-column">
            <h2 class:list={['sector-column-title', colorClasses[i % colorClasses.length]]}>{group.nombre}</h2>
            <ul>
              {group.items.map((v) => (
                <li>
                  <a href={withBase(`/sectores/${v.data.slug}`)}>{v.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection heading="¿No encontrás tu rubro? Contanos tu caso igual" />
</BaseLayout>
