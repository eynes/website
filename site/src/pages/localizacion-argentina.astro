---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import FAQAccordion from '../components/shared/FAQAccordion.astro';
import CTASection from '../components/cta/CTASection.astro';
import { splitSections, renderSection, extractLabeled } from '../lib/sections';
import { getPublished } from '../lib/content';
import { resolvePublishedRelated } from '../lib/related';
import { serviceSchema, faqPageSchema, breadcrumbListSchema } from '../lib/schema';
import { withBase } from '../lib/url';

const page = await getEntry('paginasUnicas', 'localizacion-argentina');
const sections = page ? splitSections(page.body ?? '') : {};

const subtitle = extractLabeled(sections['01']?.body, 'Subtítulo');
const problemHtml = await renderSection(sections, '02');
const circuitoHtml = await renderSection(sections, '04');
const alcanceHtml = await renderSection(sections, '05');

const fichas = await getPublished('localizacionArgentina');
const grupos = ['Facturar y vender', 'Cobrar y pagar', 'Operar y cerrar'].map((nombre) => ({
  nombre,
  fichas: fichas.filter((f) => f.data.agrupador === nombre),
}));

const experiencia = (
  await Promise.all(
    [
      { slug: 'supply-parts', nota: 'Portal de clientes, cuentas corrientes y recibos de cobro conectados con ventas y ARCA.' },
      { slug: 'rc-distribuciones', nota: 'Cobranza de viajantes, notas de crédito con CAE y comisiones según Ley 14.546.' },
      { slug: 'cidefama-s-a', nota: 'Costeo de importación, multimoneda y administración de la operación.' },
    ].map(async ({ slug, nota }) => {
      const caso = await resolvePublishedRelated('casosDeExito', slug);
      return caso ? { caso, nota } : null;
    })
  )
).filter(Boolean) as { caso: NonNullable<Awaited<ReturnType<typeof resolvePublishedRelated<'casosDeExito'>>>>; nota: string }[];

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Localización Argentina', url: '/localizacion-argentina' },
];

const jsonLd = page
  ? [
      serviceSchema({
        name: page.data.title,
        description: page.data.meta_description,
        url: 'https://eynes.com.ar/localizacion-argentina',
      }),
      faqPageSchema(page.data.faqs),
      breadcrumbListSchema(crumbs),
    ].filter(Boolean)
  : [];
---

<BaseLayout title={page?.data.seo_title ?? ''} description={page?.data.meta_description ?? ''} jsonLd={jsonLd as Record<string, unknown>[]}>
  <Breadcrumbs crumbs={crumbs} />
  <Hero understated
    title={page?.data.title ?? ''}
    subtitle={subtitle}
    showPartnerBadge={false}
  />

  <section class="section">
    <div class="container-page reveal">
      <div class="prose-content max-w-3xl" set:html={problemHtml} />
    </div>
  </section>

  {
    grupos.some((g) => g.fichas.length > 0) && (
      <section class="section bg-paper-dim" id="capacidades">
        <div class="container-page reveal">
          <h2 class="mt-2 text-2xl sm:text-3xl">Todo lo que resuelve, en un solo lugar</h2>
          <div class="mt-8 grid gap-10 sm:grid-cols-3">
            {grupos.map((g) => (
              <div>
                <h3 class="text-lg font-semibold text-ink">{g.nombre}</h3>
                <ul class="mt-4 space-y-3">
                  {g.fichas.map((f) => (
                    <li>
                      <a href={withBase(`/localizacion-argentina/${f.data.slug}`)} class="text-sm font-medium text-teal hover:underline">
                        {f.data.title} <span class="arrow">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-page reveal">
      <div class="prose-content max-w-3xl" set:html={circuitoHtml} />
    </div>
  </section>

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <div class="prose-content max-w-3xl" set:html={alcanceHtml} />
    </div>
  </section>

  {
    experiencia.length > 0 && (
      <section class="section">
        <div class="container-page reveal">
          <h2 class="mt-2 text-2xl sm:text-3xl">Experiencia documentada</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-3">
            {experiencia.map(({ caso, nota }) => (
              <a href={withBase(`/casos/${caso.data.slug}`)} class="card block">
                <p class="font-semibold text-ink">{caso.data.cliente}</p>
                <p class="mt-2 text-sm text-ink-soft">{nota}</p>
                <span class="mt-4 inline-block text-sm font-medium text-teal">Ver caso <span class="arrow">→</span></span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <FAQAccordion faqs={page?.data.faqs ?? []} />

  <CTASection
    heading="Mostranos cómo factura, cobra y paga tu empresa"
    body="Contanos qué circuitos necesitás integrar. Revisamos el alcance de la localización y preparamos una demo centrada en tu operación."
    whatsappMessage="Hola, quiero ver la localización argentina de Odoo en acción."
  />
</BaseLayout>
