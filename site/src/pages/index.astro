---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import CTASection from '../components/cta/CTASection.astro';
import { getPublished } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/schema';

const page = await getEntry('paginasUnicas', 'home');
const site = await getEntry('siteConfig', 'site');

const verticales = await getPublished('verticales');
const casos = await getPublished('casosDeExito');
const posts = await getPublished('blog');

const featuredCase =
  casos.find((c) => c.data.slug === 'supply-parts') ?? casos[0] ?? null;
const recentPosts = posts
  .sort((a, b) => (b.data.fecha_publicacion > a.data.fecha_publicacion ? 1 : -1))
  .slice(0, 3);

const dolorAlivio = [
  { dolor: '"Facturo en un sistema y vendo en otro"', alivio: 'Ventas + Facturación ARCA integradas', href: '/modulos/ventas-y-crm' },
  { dolor: '"No sé qué stock tengo en tiempo real"', alivio: 'Inventario centralizado', href: '/modulos/inventario' },
  { dolor: '"Mis reportes tardan días"', alivio: 'Reporting en vivo', href: '/modulos/contabilidad-y-finanzas' },
];

const modulos = await getPublished('modulos');

const jsonLd = site ? [organizationSchema(site.data), websiteSchema(site.data)] : [];
---

<BaseLayout
  title={page?.data.seo_title ?? 'Eynes'}
  description={page?.data.meta_description ?? ''}
  jsonLd={jsonLd}
>
  <Hero
    title={page?.data.title ?? ''}
    subtitle="Con Odoo, vendés, facturás con ARCA y controlás el stock desde un solo sistema — implementado por un equipo con 20+ años y soporte humano real, no un ticket genérico."
    primaryCta={{ label: 'Agendar demo', href: '/demo' }}
    secondaryCta={{ label: 'Ver módulos', href: '/modulos' }}
  />

  {
    site && (
      <section class="border-b border-line bg-paper-dim py-8">
        <div class="container-page reveal flex flex-wrap items-center justify-center gap-x-10 gap-y-4 text-center">
          <p class="text-lg font-semibold text-ink">
            {site.data.prueba_social_home.empresas_clientes} · {site.data.prueba_social_home.anios_experiencia} · {site.data.prueba_social_home.paises}
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-2 font-mono text-xs uppercase tracking-wide text-ink-faint">
            {site.data.prueba_social_home.logos_clientes_destacados.map((logo) => (
              <span>{logo}</span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container-page reveal">
      <span class="kicker">02 — Rubros</span>
      <h2 class="mt-2 text-2xl sm:text-3xl">Trabajamos con empresas como la tuya</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {verticales.map((v) => (
          <a href={`/verticales/${v.data.slug}`} class="card block">
            <p class="font-semibold text-ink">{v.data.title}</p>
            <span class="mt-2 inline-block text-sm font-medium text-teal">Ver solución <span class="arrow">→</span></span>
          </a>
        ))}
        <a href="/verticales" class="card flex flex-col items-center justify-center border-dashed text-center text-sm font-medium text-ink-faint hover:text-purple">
          Ver todos los rubros <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <span class="kicker">03 — Antes / después</span>
      <h2 class="mt-2 text-2xl sm:text-3xl">De la planilla al sistema, en un solo lugar</h2>
      <div class="mt-8 overflow-x-auto rounded-md border border-line">
        <table class="w-full min-w-[480px] border-collapse bg-paper text-sm">
          <thead>
            <tr>
              <th class="border-b border-line px-5 py-3 text-left font-mono text-xs font-semibold uppercase tracking-wide text-ink-soft">Hoy</th>
              <th class="border-b border-line px-5 py-3 text-left font-mono text-xs font-semibold uppercase tracking-wide text-ink-soft">Con Odoo y Eynes</th>
              <th class="border-b border-line px-5 py-3" />
            </tr>
          </thead>
          <tbody>
            {dolorAlivio.map((row) => (
              <tr>
                <td class="border-b border-line px-5 py-4 text-ink-soft">{row.dolor}</td>
                <td class="border-b border-line px-5 py-4 font-medium text-ink">{row.alivio}</td>
                <td class="border-b border-line px-5 py-4 text-right">
                  <a href={row.href} class="font-medium text-teal hover:underline">Ver módulo <span class="arrow">→</span></a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page reveal">
      <a href="/localizacion-argentina" class="card block bg-dark text-paper hover:border-silver">
        <span class="kicker">Módulo insignia</span>
        <h2 class="mt-3 text-2xl text-paper sm:text-3xl">La localización argentina más completa del mercado</h2>
        <p class="mt-2 max-w-2xl text-paper/70">ARCA, IIBB, percepciones y retenciones — nativo, sin parches de terceros.</p>
        <span class="mt-4 inline-block font-semibold text-silver">Conocer más <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <span class="kicker">04 — Módulos</span>
      <h2 class="mt-2 text-2xl sm:text-3xl">Todo lo que podés gestionar con Odoo</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {modulos.map((m) => (
          <a href={`/modulos/${m.data.slug}`} class="card block bg-paper text-center font-medium">{m.data.title}</a>
        ))}
      </div>
    </div>
  </section>

  {
    featuredCase && (
      <section class="section">
        <div class="container-page reveal">
          <span class="kicker">05 — Prueba</span>
          <h2 class="mt-2 text-2xl sm:text-3xl">Caso de éxito destacado</h2>
          <a href={`/casos/${featuredCase.data.slug}`} class="card mt-6 block sm:flex sm:items-center sm:justify-between sm:gap-6">
            <div>
              <p class="font-semibold text-ink">{featuredCase.data.cliente}</p>
              <p class="mt-1 font-mono text-xs uppercase tracking-wide text-ink-faint">
                {featuredCase.data.rubro.replace(/-/g, ' ')} · {featuredCase.data.usuarios} usuarios · {featuredCase.data.pais}
              </p>
              <p class="mt-3 max-w-2xl text-ink-soft">{featuredCase.data.resultado_clave}</p>
            </div>
            <span class="mt-4 inline-block font-semibold text-teal sm:mt-0 sm:shrink-0">Ver caso completo <span class="arrow">→</span></span>
          </a>
        </div>
      </section>
    )
  }

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <span class="kicker">06 — Por qué Eynes</span>
      <h2 class="mt-2 text-2xl sm:text-3xl">Por qué Eynes</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        <div class="card bg-paper">
          <p class="font-semibold text-ink">20+ años y +150 clientes</p>
          <p class="mt-2 text-sm text-ink-soft">Fundada en 2006, Silver Partner Oficial de Odoo — no un revendedor de un mes.</p>
        </div>
        <div class="card bg-paper">
          <p class="font-semibold text-ink">Soporte humano, no ticket genérico</p>
          <p class="mt-2 text-sm text-ink-soft">Hablás con la misma gente que te implementó el sistema.</p>
        </div>
        <div class="card bg-paper">
          <p class="font-semibold text-ink">Presencia real en 5 ciudades</p>
          <p class="mt-2 text-sm text-ink-soft">Oficina en Buenos Aires y atención local con teléfono dedicado en Santa Fe, Mendoza, Montevideo y Valencia/Castellón.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    heading="Contanos tu proyecto"
    body="Una reunión de una hora, sin compromiso — te llevás un presupuesto igual."
    whatsappMessage="Hola, quiero agendar una demo de Odoo con Eynes."
  />

  {
    recentPosts.length > 0 && (
      <section class="section">
        <div class="container-page reveal">
          <span class="kicker">08 — Blog</span>
          <h2 class="mt-2 text-2xl sm:text-3xl">Últimas notas</h2>
          <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {recentPosts.map((post) => (
              <a href={`/blog/${post.data.slug}`} class="card block">
                <p class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">{post.data.categoria.replace(/-/g, ' ')}</p>
                <p class="mt-2 font-semibold text-ink">{post.data.title}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
