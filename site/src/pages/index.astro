---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import ClientLogos from '../components/shared/ClientLogos.astro';
import CTASection from '../components/cta/CTASection.astro';
import ModuleIcon from '../components/shared/ModuleIcon.astro';
import CaseCard from '../components/casos/CaseCard.astro';
import { getPublished } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/schema';
import { withBase } from '../lib/url';

const page = await getEntry('paginasUnicas', 'home');
const site = await getEntry('siteConfig', 'site');

const casos = await getPublished('casosDeExito');

const featuredCase =
  casos.find((c) => c.data.slug === 'supply-parts') ?? casos[0] ?? null;

const modulos = await getPublished('modulos');

const jsonLd = site ? [organizationSchema(site.data), websiteSchema(site.data)] : [];
---

<BaseLayout
  title={page?.data.seo_title ?? 'Eynes'}
  description={page?.data.meta_description ?? ''}
  jsonLd={jsonLd}
>
  <Hero
    title={page?.data.title ?? ''}
    subtitle="Con Odoo, vendés, facturás con ARCA y controlás el stock desde un solo sistema — implementado por un equipo con 20+ años y soporte humano real, no un ticket genérico."
    primaryCta={{ label: 'Agendar demo', href: '/demo' }}
    secondaryCta={{ label: 'Ver módulos', href: '/modulos' }}
    showPartnerBadge={false}
  />

  {
    site && (
      <section class="trust-strip border-b border-line py-8">
        <div class="container-page reveal text-center">
          <p class="text-lg font-semibold text-ink">
            {site.data.prueba_social_home.empresas_clientes} · {site.data.prueba_social_home.anios_experiencia} · {site.data.prueba_social_home.paises}
          </p>

          <ClientLogos />
        </div>
      </section>
    )
  }

  <section class="section flagship-section">
    <div class="container-page reveal">
      <a href={withBase('/localizacion-argentina')} class="card flagship-card block bg-dark text-paper hover:border-silver">
        <span class="kicker">Módulo insignia</span>
        <h2 class="mt-3 text-2xl text-paper sm:text-3xl">La localización argentina más completa del mercado</h2>
        <p class="mt-2 max-w-2xl text-paper/70">ARCA, IIBB, percepciones y retenciones — nativo, sin parches de terceros.</p>
        <span class="mt-4 inline-block font-semibold text-silver">Conocer más <span class="arrow">→</span></span>
      </a>
    </div>
  </section>

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <h2 class="mt-2 text-2xl sm:text-3xl">Todo lo que podés gestionar con Odoo</h2>
      <div class="module-grid mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {modulos.map((m, i) => (
          <a href={withBase(`/modulos/${m.data.slug}`)} class="card block bg-paper font-medium">
            <ModuleIcon slug={m.data.slug} index={i} />
            {m.data.title}
          </a>
        ))}
      </div>
    </div>
  </section>

  {
    featuredCase && (
      <section class="section">
        <div class="container-page reveal">
          <h2 class="mt-2 text-2xl sm:text-3xl">Caso de éxito destacado</h2>
          <div class="mt-6 max-w-xl">
            <CaseCard entry={featuredCase} />
          </div>
        </div>
      </section>
    )
  }

  <section class="section bg-paper-dim">
    <div class="container-page reveal">
      <h2 class="mt-2 text-2xl sm:text-3xl">Por qué Eynes</h2>
      <div class="reasons-grid mt-8 grid gap-5 sm:grid-cols-3">
        <div class="card bg-paper">
          <p class="font-semibold text-ink">20+ años y +150 clientes</p>
          <p class="mt-2 text-sm text-ink-soft">Fundada en 2006, Silver Partner Oficial de Odoo — no un revendedor de un mes.</p>
        </div>
        <div class="card bg-paper">
          <p class="font-semibold text-ink">Soporte humano, no ticket genérico</p>
          <p class="mt-2 text-sm text-ink-soft">Hablás con la misma gente que te implementó el sistema.</p>
        </div>
        <div class="card bg-paper">
          <p class="font-semibold text-ink">Presencia real en 5 ciudades</p>
          <p class="mt-2 text-sm text-ink-soft">Oficina en Buenos Aires y atención local con teléfono dedicado en Santa Fe, Mendoza, Montevideo y Valencia/Castellón.</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection
    heading="Contanos tu proyecto"
    body="Una reunión de 30 minutos, sin compromiso — te llevás un presupuesto igual."
    whatsappMessage="Hola, quiero agendar una demo de Odoo con Eynes."
  />

</BaseLayout>
