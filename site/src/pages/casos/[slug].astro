---
import FAQAccordion from '../../components/shared/FAQAccordion.astro';
import { withBase } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import ContentSection from '../../components/shared/ContentSection.astro';
import CaseFactsTable from '../../components/casos/CaseFactsTable.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { splitSections, renderSection, renderFragment } from '../../lib/sections';
import { articleSchema, breadcrumbListSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const casos = await getPublished('casosDeExito');
  return casos.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const sections = splitSections(entry.body ?? '');

const problemHtml = await renderSection(sections, '03');
// The page heading already identifies the client; omit a repeated opening label.
const implementation = sections['04']?.body ?? '';
const clientName = entry.data.cliente.trim();
const originalTitle = entry.data.title.trim();
const titleStartsWithClient = originalTitle.slice(0, clientName.length).toLocaleLowerCase() === clientName.toLocaleLowerCase();
const titleRemainder = originalTitle.slice(clientName.length);
const displayTitle = titleStartsWithClient && /^\s*[:—–-]\s*/.test(titleRemainder)
  ? titleRemainder.replace(/^\s*[:—–-]\s*/, '')
  : originalTitle;

const startsWithClient = implementation.slice(0, clientName.length).toLocaleLowerCase() === clientName.toLocaleLowerCase();
const afterClient = implementation.slice(clientName.length);
const solutionHtml = await renderFragment(
  startsWithClient && /^[.:]\s+/.test(afterClient)
    ? afterClient.replace(/^[.:]\s+/, '')
    : implementation
);
const showIndustry = !entry.data.title.toLocaleLowerCase().includes(entry.data.rubro.toLocaleLowerCase());
const hasFacts = showIndustry || entry.data.pais || entry.data.usuarios || entry.data.modulos_implementados.length > 0;
const resultHtml = await renderSection(sections, '05');

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Casos de éxito', url: '/casos' },
  { name: entry.data.cliente, url: `/casos/${entry.data.slug}` },
];

const jsonLd = [
  articleSchema({
    headline: entry.data.title,
    description: entry.data.meta_description,
    url: `https://eynes.com.ar/casos/${entry.data.slug}`,
  }),
  breadcrumbListSchema(crumbs),
];
---

<BaseLayout title={entry.data.seo_title} description={entry.data.meta_description} jsonLd={jsonLd}>
  <Breadcrumbs crumbs={crumbs} />
  <Hero understated title={displayTitle} showPartnerBadge={false}>
    {hasFacts && <div slot="details" class="mt-8 sm:mt-10">
      <CaseFactsTable
        rubro={showIndustry ? entry.data.rubro : ''}
        pais={entry.data.pais}
        usuarios={entry.data.usuarios}
        modulos={entry.data.modulos_implementados}
      />
    </div>}
  </Hero>

  <ContentSection number="03" title="El problema" html={problemHtml} narrow />
  <ContentSection number="04" title="La solución" html={solutionHtml} narrow tone="muted" />
  <ContentSection number="05" title={entry.data.portfolio ? "Testimonio" : "El resultado"} html={resultHtml} narrow />

  {['06', '07', '08', '09'].map(async (key) => (
    <ContentSection title={sections[key]?.title} html={await renderSection(sections, key)} narrow />
  ))}
  <FAQAccordion faqs={entry.data.faqs} title="Preguntas frecuentes del rubro" />
  <div class="container-page pb-8"><a class="text-teal underline" href={withBase('/verticales')}>Explorá todos los rubros →</a></div>

  <CTASection heading="Quiero un resultado similar en mi empresa" />
</BaseLayout>
