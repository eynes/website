---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import CTASection from '../../components/cta/CTASection.astro';
import { getPublished } from '../../lib/content';
import { collectionPageSchema, breadcrumbListSchema } from '../../lib/schema';
import CaseCard from '../../components/casos/CaseCard.astro';

const hub = await getEntry('casosHub', 'casos');
const casos = await getPublished('casosDeExito');

const crumbs = [
  { name: 'Inicio', url: '/' },
  { name: 'Casos de éxito', url: '/casos' },
];

const jsonLd = hub
  ? [
      collectionPageSchema(
        hub.data.title,
        hub.data.meta_description,
        casos.map((c) => `https://eynes.com.ar/casos/${c.data.slug}`)
      ),
      breadcrumbListSchema(crumbs),
    ]
  : [];
---

<BaseLayout title={hub?.data.seo_title ?? ''} description={hub?.data.meta_description ?? ''} jsonLd={jsonLd}>
  <Hero understated title={hub?.data.title ?? ''} showPartnerBadge={false} compact />

  <section class="section collection-section">
    <div class="container-page case-list grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        casos.map((c) => (
          <CaseCard entry={c} />
        ))
      }
    </div>
  </section>

  <CTASection heading="¿Querés un resultado similar en tu empresa?" />
</BaseLayout>
