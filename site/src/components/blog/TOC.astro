---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2);
---

{
  items.length > 0 && (
    <nav aria-label="En esta nota" class="card sticky top-24">
      <p class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">En esta nota</p>
      <ul class="mt-3 space-y-2 text-sm">
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`} class="text-ink-soft hover:text-purple hover:underline">
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
