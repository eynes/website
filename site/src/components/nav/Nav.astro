---
import { getEntry } from 'astro:content';
import PartnerBadge from '../shared/PartnerBadge.astro';
import { withBase } from '../../lib/url';
import { getPublished } from '../../lib/content';
import { groupColorClass, sortGroups } from '../../lib/sectorGroups';

const nav = await getEntry('navConfig', 'navegacion');
const site = await getEntry('siteConfig', 'site');
const base = import.meta.env.BASE_URL;
const baseNoTrailingSlash = base.endsWith('/') ? base.slice(0, -1) : base;
const currentPath = Astro.url.pathname.slice(baseNoTrailingSlash.length) || '/';

function isActive(url: string) {
  return url !== '/' && currentPath.startsWith(url);
}

const verticales = await getPublished('verticales');
const sectorGroups = sortGroups(
  [...new Set(verticales.map((v) => v.data.agrupador))].map((nombre) => ({
    nombre,
    colorClass: groupColorClass(nombre),
    items: verticales.filter((v) => v.data.agrupador === nombre),
  }))
);
---

<header class="site-nav sticky top-0 z-40 border-b bg-paper" style="border-color: var(--color-line)">
  <div class="container-page flex items-center justify-between gap-4 py-4">
    <div class="site-brand flex shrink-0 items-center gap-3">
      <a href={withBase('/')} aria-label={site?.data.nombre_comercial ?? 'Eynes'}>
        <img
          src={withBase('/brand/eynes-logo.png')}
          alt={site?.data.nombre_comercial ?? 'Eynes'}
          class="site-logo"
          width="174"
          height="60"
        />
      </a>
      <span class="site-brand-divider hidden sm:inline-block" aria-hidden="true"></span>
      <span class="hidden sm:inline-block">
        <PartnerBadge size="lg" />
      </span>
    </div>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      <div class="nav-mega" data-mega>
        <button
          type="button"
          class:list={['nav-link nav-mega-trigger', { 'text-purple': isActive('/sectores') }]}
          aria-expanded="false"
          aria-controls="mega-sectores"
          data-mega-trigger
        >
          Sectores
          <svg class="nav-mega-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div class="nav-mega-collapse" id="mega-sectores" data-mega-collapse>
          <div class="nav-mega-panel">
            <div class="nav-mega-columns">
              {sectorGroups.map((group) => (
                <div class="nav-mega-column">
                  <p class:list={['nav-mega-group', group.colorClass]}>{group.nombre}</p>
                  <ul>
                    {group.items.map((v) => (
                      <li><a href={withBase(`/sectores/${v.data.slug}`)}>{v.data.title}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <div class="nav-mega-footer">
              <a href={withBase('/sectores')} class="nav-mega-all">Ver todos los rubros <span class="arrow">→</span></a>
            </div>
          </div>
        </div>
      </div>

      {
        nav?.data.nav_principal.filter((item) => item.etiqueta !== 'Sectores').map((item) => (
          <a
            href={withBase(item.url)}
            class:list={['nav-link', { 'text-purple': isActive(item.url) }]}
          >
            {item.etiqueta}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      {nav && <a href={withBase(nav.data.cta_nav.url)} class="btn-primary hidden sm:inline-flex">{nav.data.cta_nav.etiqueta}</a>}
      <button
        type="button"
        id="nav-toggle"
        class="inline-flex items-center justify-center p-2 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile"
        aria-label="Abrir menú"
      >
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="nav-mobile" class="hidden border-t lg:hidden" style="border-color: var(--color-line)" aria-label="Principal (móvil)">
    <div class="container-page flex flex-col gap-1 py-3">
      <div class="nav-mega nav-mega-mobile" data-mega>
        <button
          type="button"
          class:list={['nav-mobile-link nav-mega-trigger', { 'text-purple': isActive('/sectores') }]}
          aria-expanded="false"
          aria-controls="mega-sectores-mobile"
          data-mega-trigger
        >
          Sectores
          <svg class="nav-mega-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
          </svg>
        </button>
        <div class="nav-mega-collapse" id="mega-sectores-mobile" data-mega-collapse>
          <div class="nav-mega-panel-mobile">
            {sectorGroups.map((group) => (
              <div class="nav-mega-column">
                <p class:list={['nav-mega-group', group.colorClass]}>{group.nombre}</p>
                <ul>
                  {group.items.map((v) => (
                    <li><a href={withBase(`/sectores/${v.data.slug}`)}>{v.data.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <a href={withBase('/sectores')} class="nav-mega-all">Ver todos los rubros <span class="arrow">→</span></a>
          </div>
        </div>
      </div>

      {
        nav?.data.nav_principal.filter((item) => item.etiqueta !== 'Sectores').map((item) => (
          <a href={withBase(item.url)} class="nav-mobile-link">
            {item.etiqueta}
          </a>
        ))
      }
      {nav && <a href={withBase(nav.data.cta_nav.url)} class="btn-primary mt-2 justify-center">{nav.data.cta_nav.etiqueta}</a>}
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
    if (expanded) closeAllMegas();
  });

  // Expanding/collapsing mega-menus (desktop dropdown + mobile accordion):
  // height is measured from scrollHeight so the reveal animates smoothly
  // to its real content size, then closes back to 0 on a second click.
  const megas = Array.from(document.querySelectorAll<HTMLElement>('[data-mega]'));

  function setOpen(mega: HTMLElement, open: boolean) {
    const trigger = mega.querySelector<HTMLButtonElement>('[data-mega-trigger]');
    const collapse = mega.querySelector<HTMLElement>('[data-mega-collapse]');
    if (!trigger || !collapse) return;
    trigger.setAttribute('aria-expanded', String(open));
    mega.classList.toggle('is-open', open);
    collapse.style.maxHeight = open ? `${collapse.scrollHeight}px` : '0px';
  }

  function closeAllMegas(except?: HTMLElement) {
    megas.forEach((mega) => {
      if (mega !== except) setOpen(mega, false);
    });
  }

  megas.forEach((mega) => {
    const trigger = mega.querySelector<HTMLButtonElement>('[data-mega-trigger]');
    trigger?.addEventListener('click', () => {
      const willOpen = trigger.getAttribute('aria-expanded') !== 'true';
      closeAllMegas(willOpen ? mega : undefined);
      setOpen(mega, willOpen);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    const insideAnyMega = megas.some((mega) => mega.contains(target));
    if (!insideAnyMega) closeAllMegas();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllMegas();
  });

  window.addEventListener('resize', () => {
    megas.forEach((mega) => {
      if (mega.classList.contains('is-open')) setOpen(mega, true);
    });
  });
</script>
