---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import clients from '../../../../content/04-casos-de-exito/clientes.json';
import { withBase } from '../../lib/url';

interface Props { entry: CollectionEntry<'casosDeExito'>; destacado?: boolean; compact?: boolean; }
const { entry, destacado = false, compact = false } = Astro.props;
const client = (clients as Record<string, { website: string; logo: string }>)[entry.data.slug];
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../../../content/04-casos-de-exito/logos-clientes/*.{svg,png,webp,jpg,jpeg,avif}',
  { eager: true }
);
const logo = client?.logo ? images[`../../../../content/04-casos-de-exito/logos-clientes/${client.logo}`]?.default : undefined;
const domain = client?.website ? new URL(client.website).hostname.replace(/^www\./, '') : '';
const href = withBase(`/casos/${entry.data.slug}`);
const meta = [entry.data.rubro, entry.data.pais, entry.data.usuarios && `${entry.data.usuarios} usuarios`].filter(Boolean).join(' · ');
---

{compact ? (
  <a href={href} class="card case-card case-card--compact block">
    <div class="case-card-heading">
      <h2 class="case-name">
        {destacado && (
          <svg class="case-star" viewBox="0 0 20 20" aria-label="Caso destacado" role="img">
            <path d="M10 1.5l2.35 5.06 5.4.6-4.02 3.78 1.1 5.36L10 13.6l-4.83 2.7 1.1-5.36-4.02-3.78 5.4-.6z" />
          </svg>
        )}
        {entry.data.cliente}
      </h2>
      {logo && <div class="case-card-logo"><img src={logo.src} alt={`Logo de ${entry.data.cliente}`} width={logo.width} height={logo.height} loading="lazy" /></div>}
    </div>
    <p class="case-meta">{meta}</p>
    <span class="case-link">Ver caso <span class="arrow" aria-hidden="true">→</span></span>
  </a>
) : (
  <article class="card case-card">
    <div class="case-card-heading">
      <h2 class="case-name">
        {destacado && (
          <svg class="case-star" viewBox="0 0 20 20" aria-label="Caso destacado" role="img">
            <path d="M10 1.5l2.35 5.06 5.4.6-4.02 3.78 1.1 5.36L10 13.6l-4.83 2.7 1.1-5.36-4.02-3.78 5.4-.6z" />
          </svg>
        )}
        <a href={href}>{entry.data.cliente}</a>
      </h2>
      {logo && <div class="case-card-logo"><img src={logo.src} alt={`Logo de ${entry.data.cliente}`} width={logo.width} height={logo.height} loading="lazy" /></div>}
    </div>
    <p class="case-meta">{meta}</p>
    <p class="case-result">{entry.data.resultado_clave}</p>
    <div class="case-links">
      <a href={href} class="case-link">Ver caso <span aria-hidden="true">→</span></a>
      {client?.website && <a href={client.website} target="_blank" rel="noopener noreferrer" class="client-link" aria-label={`Sitio web de ${entry.data.cliente}: ${domain} (abre en otra pestaña)`}>{domain} <span aria-hidden="true">↗</span></a>}
    </div>
  </article>
)}

<style>
  .case-card { display: flex; flex-direction: column; gap: 0; }
  .case-star { display: inline-block; width: 13px; height: 13px; margin-right: 6px; margin-bottom: -1px; fill: color-mix(in srgb, var(--color-teal) 55%, var(--color-silver)); }
  .case-card .case-name { font-size: 1.125rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.5; margin: 0; text-wrap: initial; }
  .case-name a:hover { color: var(--color-purple); }
  .case-meta { font-size: 0.8125rem; line-height: 1.5; color: var(--color-ink-faint); margin-top: 6px; }
  .case-result { font-size: 0.875rem; line-height: 1.75; color: var(--color-ink-soft); margin-block: 20px 28px; }
  .case-links { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 20px; margin-top: auto; padding-top: 18px; border-top: 1px solid var(--color-line); font-size: 0.8125rem; }
  .case-link { color: var(--color-teal); font-weight: 500; }
  .client-link { color: var(--color-ink-soft); overflow-wrap: anywhere; }
  .case-links a:hover { text-decoration: underline; }
  .case-card--compact .case-link { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--color-line); }
  .case-card--compact:hover .case-link { color: var(--color-purple); }
</style>
