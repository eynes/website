---
interface Props {
  rubro: string;
  pais: string;
  usuarios: number | string;
  modulos: string[];
}

const { rubro, pais, usuarios, modulos } = Astro.props;
---

<dl class="grid grid-cols-2 gap-x-6 gap-y-5 rounded-md border border-line bg-paper-dim p-6 sm:grid-cols-4">
  <div>
    <dt class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">Rubro</dt>
    <dd class="mt-1.5 font-medium text-ink">{rubro.replace(/-/g, ' ')}</dd>
  </div>
  <div>
    <dt class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">País</dt>
    <dd class="mt-1.5 font-medium text-ink">{pais}</dd>
  </div>
  <div>
    <dt class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">Usuarios</dt>
    <dd class="mt-1.5 font-medium text-ink">{usuarios}</dd>
  </div>
  <div>
    <dt class="font-mono text-xs font-semibold uppercase tracking-wide text-teal">Módulos</dt>
    <dd class="mt-1.5 font-medium text-ink">{modulos.join(', ')}</dd>
  </div>
</dl>
