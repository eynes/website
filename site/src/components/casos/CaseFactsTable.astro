---
interface Props {
  rubro: string;
  pais: string;
  usuarios: number | string;
  modulos: string[];
}

const { rubro, pais, usuarios, modulos } = Astro.props;
---

<dl class="case-facts">
  <div>
    <dt class="sr-only">Rubro</dt>
    <dd class="case-facts-value">{rubro.replace(/-/g, ' ')}</dd>
  </div>
  {pais && <div>
    <dt class="case-facts-label">País</dt>
    <dd class="case-facts-value">{pais}</dd>
  </div>}
  {usuarios && <div>
    <dt class="case-facts-label">Usuarios</dt>
    <dd class="case-facts-value">{usuarios}</dd>
  </div>}
  {modulos.length > 0 && <div>
    <dt class="case-facts-label">Módulos</dt>
    <dd class="case-facts-value">{modulos.join(', ')}</dd>
  </div>}
</dl>

<style>
  .case-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 32px;
    max-width: 900px;
  }
  .case-facts > div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 10px;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .case-facts-label { color: var(--color-ink-faint); }
  .case-facts-value { color: var(--color-purple); font-weight: 500; }
</style>
