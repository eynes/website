---
import { getEntry } from 'astro:content';
import { withBase } from '../../lib/url';

interface Props {
  size?: 'sm' | 'md' | 'lg';
}

const { size = 'md' } = Astro.props;
const heightClass = { sm: 'h-8', md: 'h-10', lg: 'h-20' } as const;
const site = await getEntry('siteConfig', 'site');
---

{
  site && (
    <a
      href={site.data.badge_partner.link_verificacion}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 opacity-95 transition-opacity hover:opacity-100"
      aria-label={site.data.badge_partner.texto}
    >
      <img
        src={withBase('/brand/odoo_silver_partner_rgb.svg')}
        alt="Silver Partner Oficial de Odoo"
        class:list={[heightClass[size], 'w-auto']}
        width="600"
        height="300"
        loading="eager"
      />
    </a>
  )
}
