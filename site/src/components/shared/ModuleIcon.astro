---
import { withBase } from '../../lib/url';
import { getModuleIcon } from '../../lib/moduleIcons';

interface Props {
  slug: string;
  index?: number;
}

const { slug } = Astro.props;
const { file } = getModuleIcon(slug);
---

<span class="module-icon">
  <img src={withBase(`/icons/odoo/${file}.svg`)} alt="" width="28" height="28" loading="lazy" />
</span>
