---
import { withBase } from '../../lib/url';

interface Props {
  slug: string;
  index?: number;
}

const { slug } = Astro.props;

const ICONS: Record<string, string> = {
  'ventas-y-crm': 'crm',
  inventario: 'stock',
  compras: 'purchase',
  'contabilidad-y-finanzas': 'account_accountant',
};

const file = ICONS[slug] ?? 'base';
---

<span class="module-icon">
  <img src={withBase(`/icons/odoo/${file}.svg`)} alt="" width="28" height="28" loading="lazy" />
</span>
