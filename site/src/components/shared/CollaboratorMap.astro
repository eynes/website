---
interface Ubicacion {
  nombre: string;
  pais: string;
  lat: number;
  lon: number;
}

interface Props {
  ubicaciones: Ubicacion[];
  cantidadPersonas: string;
}

const { ubicaciones, cantidadPersonas } = Astro.props;

// Proyección equirectangular simple sobre un viewBox de 1000x500.
const project = (lat: number, lon: number) => ({
  x: ((lon + 180) / 360) * 1000,
  y: ((90 - lat) / 180) * 500,
});

// Un marcador por país (centroide de sus ubicaciones), para que el mapa
// mundial quede legible en vez de amontonar 6 puntos de Argentina.
const paisesOrdenados = [...new Set(ubicaciones.map((u) => u.pais))];
const marcadores = paisesOrdenados.map((pais) => {
  const puntos = ubicaciones.filter((u) => u.pais === pais);
  const lat = puntos.reduce((sum, p) => sum + p.lat, 0) / puntos.length;
  const lon = puntos.reduce((sum, p) => sum + p.lon, 0) / puntos.length;
  return { pais, ciudades: puntos.map((p) => p.nombre).join(', '), ...project(lat, lon) };
});
---

<div class="collaborator-map">
  <div class="collaborator-map__stat">
    <p class="collaborator-map__stat-number">{cantidadPersonas}</p>
    <p class="collaborator-map__stat-label">personas en el equipo</p>
  </div>

  <div class="collaborator-map__frame">
    <svg class="collaborator-map__visual" viewBox="0 0 1000 500" role="img" aria-labelledby="collaborator-map-title collaborator-map-description">
      <title id="collaborator-map-title">Dónde trabaja el equipo de Eynes</title>
      <desc id="collaborator-map-description">Mapa esquemático del mundo con Argentina y España destacadas, los países donde vive el equipo de Eynes.</desc>

      <defs>
        <filter id="collaborator-map-glow" x="-200%" y="-200%" width="500%" height="500%">
          <feGaussianBlur stdDeviation="8" />
        </filter>
      </defs>

      <line class="collaborator-map__grid-line" x1="0" y1="143" x2="1000" y2="143" />
      <line class="collaborator-map__grid-line" x1="0" y1="250" x2="1000" y2="250" />
      <line class="collaborator-map__grid-line" x1="0" y1="357" x2="1000" y2="357" />

      <!-- Continentes en forma esquemática, no cartografía precisa. -->
      <g class="collaborator-map__continents">
        <path d="M40,90 C90,40 220,30 300,70 C360,100 350,150 320,180 C300,205 270,225 240,235 C190,210 150,220 120,190 C70,170 30,140 40,90 Z" />
        <path d="M300,230 C340,220 390,235 400,270 C410,310 395,350 380,390 C365,420 345,440 325,400 C310,370 300,340 295,300 C290,270 285,245 300,230 Z" />
        <path d="M470,90 C500,60 560,55 600,75 C620,90 615,120 600,140 C580,155 540,150 510,140 C485,130 460,115 470,90 Z" />
        <path d="M470,150 C520,140 580,150 610,180 C630,210 625,250 615,290 C605,330 585,360 560,345 C540,330 530,300 520,270 C505,230 460,190 470,150 Z" />
        <path d="M600,60 C680,30 800,35 900,60 C970,80 995,120 985,160 C970,200 920,220 870,235 C820,250 760,240 720,220 C680,200 650,180 630,150 C610,120 590,90 600,60 Z" />
        <path d="M810,300 C850,285 900,290 925,315 C940,335 930,360 905,365 C870,370 830,360 810,340 C800,325 800,310 810,300 Z" />
      </g>

      {marcadores.length === 2 && (
        <path
          class="collaborator-map__link"
          d={`M${marcadores[0].x},${marcadores[0].y} Q${(marcadores[0].x + marcadores[1].x) / 2},${Math.min(marcadores[0].y, marcadores[1].y) - 60} ${marcadores[1].x},${marcadores[1].y}`}
        />
      )}

      {marcadores.map((m) => (
        <g class="collaborator-map__marker" transform={`translate(${m.x} ${m.y})`}>
          <circle class="collaborator-map__glow" r="16" filter="url(#collaborator-map-glow)" />
          <circle class="collaborator-map__pulse" r="10" />
          <circle class="collaborator-map__dot" r="6" />
          <text class="collaborator-map__label" x="0" y="-16">{m.pais}</text>
        </g>
      ))}
    </svg>
  </div>

  <p class="collaborator-map__caption">
    Representación esquemática · equipo en {ubicaciones.map((u) => u.nombre).join(' · ')}.
  </p>
</div>

<style>
  .collaborator-map { position: relative; }
  .collaborator-map__frame {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-dark);
  }
  .collaborator-map__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 420px 300px at 15% 85%, color-mix(in srgb, var(--color-teal) 22%, transparent), transparent 65%),
      radial-gradient(ellipse 460px 320px at 85% 15%, color-mix(in srgb, var(--color-purple-light) 20%, transparent), transparent 65%);
    pointer-events: none;
  }
  .collaborator-map__visual {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
  .collaborator-map__stat {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    left: 1.5rem;
  }
  .collaborator-map__stat-number {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-paper);
  }
  .collaborator-map__stat-label {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .collaborator-map__grid-line { stroke: rgba(255, 255, 255, 0.07); stroke-width: 1; stroke-dasharray: 3 6; }
  .collaborator-map__continents path {
    fill: color-mix(in srgb, var(--color-purple-light) 22%, var(--color-dark-soft));
    stroke: rgba(255, 255, 255, 0.06);
    stroke-width: 1;
  }
  .collaborator-map__link {
    fill: none;
    stroke: color-mix(in srgb, var(--color-teal) 55%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }
  .collaborator-map__dot { fill: var(--color-teal); }
  .collaborator-map__glow { fill: var(--color-teal); opacity: 0.5; }
  .collaborator-map__pulse {
    fill: none;
    stroke: var(--color-teal);
    stroke-width: 2;
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    animation: collaborator-pulse 2.6s ease-out infinite;
  }
  .collaborator-map__label {
    text-anchor: middle;
    fill: var(--color-paper);
    font: 600 15px var(--font-inter, sans-serif);
    letter-spacing: -0.01em;
  }
  @keyframes collaborator-pulse {
    0% { r: 6; opacity: 0.55; }
    100% { r: 26; opacity: 0; }
  }
  .collaborator-map__caption {
    margin: 0.85rem 0 0;
    font-size: 0.8125rem;
    color: var(--color-ink-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .collaborator-map__pulse { animation: none; opacity: 0; }
  }
</style>
