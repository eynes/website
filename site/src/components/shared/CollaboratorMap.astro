---
import land from 'world-atlas/land-110m.json';
import { feature } from 'topojson-client';

interface Ubicacion {
  nombre: string;
  pais: string;
  lat: number;
  lon: number;
}

interface Props {
  ubicaciones: Ubicacion[];
  cantidadPersonas: string;
}

const { ubicaciones, cantidadPersonas } = Astro.props;

// Proyección equirectangular sobre un viewBox de 1000x500 (lon -180..180,
// lat 90..-90). El viewBox visible recorta los polos (poco relevantes acá)
// para que el mapa se vea más ancho y centrado en las zonas con tierra.
const project = ([lon, lat]: [number, number]) => [
  ((lon + 180) / 360) * 1000,
  ((90 - lat) / 180) * 500,
];

// Contorno real del mundo (Natural Earth 110m vía world-atlas), no dibujado
// a mano. Cada anillo se corta en un nuevo subtrazo si salta el antimeridiano
// (lon +180/-180), para no cruzar el mapa entero con una línea espuria.
function ringToPath(ring: [number, number][]): string {
  let d = '';
  let prevLon: number | null = null;
  for (const point of ring) {
    const [x, y] = project(point);
    const jump = prevLon !== null && Math.abs(point[0] - prevLon) > 180;
    d += `${d === '' || jump ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)} `;
    prevLon = point[0];
  }
  return `${d}Z `;
}

const landGeometry = (feature(land as any, (land as any).objects.land) as any).features[0].geometry;
const worldPath: string = landGeometry.coordinates
  .map((polygon: [number, number][][]) => polygon.map(ringToPath).join(''))
  .join('');

// Un puntito real por ubicación. Dos "hubs" (uno por país) llevan el pulso y
// la etiqueta de país; el resto son puntos más chicos y quietos para no
// saturar el clúster de Argentina, que en el mundo real cae muy junto.
const hubPorPais = new Map<string, string>();
const puntos = ubicaciones.map((u) => {
  const [x, y] = project([u.lon, u.lat]);
  const esHub = hubPorPais.get(u.pais) === undefined;
  if (esHub) hubPorPais.set(u.pais, u.nombre);
  return { ...u, x, y, esHub };
});
const hubs = puntos.filter((p) => p.esHub);
---

<div class="collaborator-map">
  <div class="collaborator-map__stat">
    <p class="collaborator-map__stat-number">{cantidadPersonas}</p>
    <p class="collaborator-map__stat-label">personas en el equipo</p>
  </div>

  <div class="collaborator-map__frame">
    <svg class="collaborator-map__visual" viewBox="0 25 1000 390" role="img" aria-labelledby="collaborator-map-title collaborator-map-description">
      <title id="collaborator-map-title">Dónde trabaja el equipo de Eynes</title>
      <desc id="collaborator-map-description">
        Mapa del mundo con un punto por cada provincia o ciudad donde vive el equipo de Eynes: {ubicaciones.map((u) => `${u.nombre} (${u.pais})`).join(', ')}.
      </desc>

      <defs>
        <filter id="collaborator-map-glow" x="-200%" y="-200%" width="500%" height="500%">
          <feGaussianBlur stdDeviation="8" />
        </filter>
      </defs>

      <line class="collaborator-map__grid-line" x1="0" y1="143" x2="1000" y2="143" />
      <line class="collaborator-map__grid-line" x1="0" y1="250" x2="1000" y2="250" />
      <line class="collaborator-map__grid-line" x1="0" y1="357" x2="1000" y2="357" />

      <path class="collaborator-map__land" d={worldPath} />

      {hubs.length === 2 && (
        <path
          class="collaborator-map__link"
          d={`M${hubs[0].x},${hubs[0].y} Q${(hubs[0].x + hubs[1].x) / 2},${Math.min(hubs[0].y, hubs[1].y) - 60} ${hubs[1].x},${hubs[1].y}`}
        />
      )}

      {puntos.map((p) => (
        <g class:list={['collaborator-map__marker', p.esHub && 'is-hub']} transform={`translate(${p.x} ${p.y})`}>
          <title>{p.nombre}, {p.pais}</title>
          {p.esHub && <circle class="collaborator-map__glow" r="16" filter="url(#collaborator-map-glow)" />}
          {p.esHub && <circle class="collaborator-map__pulse" r="10" />}
          <circle class="collaborator-map__dot" r={p.esHub ? 6 : 4} />
          {p.esHub && <text class="collaborator-map__label" x="0" y="-16">{p.pais}</text>}
        </g>
      ))}
    </svg>
  </div>
</div>

<style>
  .collaborator-map { position: relative; }
  .collaborator-map__frame {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: var(--color-dark);
  }
  .collaborator-map__frame::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 420px 300px at 15% 85%, color-mix(in srgb, var(--color-teal) 22%, transparent), transparent 65%),
      radial-gradient(ellipse 460px 320px at 85% 15%, color-mix(in srgb, var(--color-purple-light) 20%, transparent), transparent 65%);
    pointer-events: none;
  }
  .collaborator-map__visual {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
  }
  .collaborator-map__stat {
    position: absolute;
    z-index: 2;
    top: 1.5rem;
    left: 1.5rem;
  }
  .collaborator-map__stat-number {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-paper);
  }
  .collaborator-map__stat-label {
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .collaborator-map__grid-line { stroke: rgba(255, 255, 255, 0.07); stroke-width: 1; stroke-dasharray: 3 6; }
  .collaborator-map__land {
    fill: color-mix(in srgb, var(--color-purple-light) 22%, var(--color-dark-soft));
    stroke: rgba(255, 255, 255, 0.08);
    stroke-width: 0.75;
  }
  .collaborator-map__link {
    fill: none;
    stroke: color-mix(in srgb, var(--color-teal) 55%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
  }
  .collaborator-map__dot { fill: var(--color-teal); }
  .collaborator-map__marker:not(.is-hub) .collaborator-map__dot { fill: color-mix(in srgb, var(--color-teal) 75%, white); }
  .collaborator-map__glow { fill: var(--color-teal); opacity: 0.5; }
  .collaborator-map__pulse {
    fill: none;
    stroke: var(--color-teal);
    stroke-width: 2;
    opacity: 0.55;
    transform-box: fill-box;
    transform-origin: center;
    animation: collaborator-pulse 2.6s ease-out infinite;
  }
  .collaborator-map__label {
    text-anchor: middle;
    fill: var(--color-paper);
    font: 600 15px var(--font-inter, sans-serif);
    letter-spacing: -0.01em;
  }
  @keyframes collaborator-pulse {
    0% { r: 6; opacity: 0.55; }
    100% { r: 26; opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .collaborator-map__pulse { animation: none; opacity: 0; }
  }
</style>
