---
import type { Faq } from '../../lib/schema';

interface Props {
  faqs: Faq[];
  title?: string;
}

const { faqs, title = 'Preguntas frecuentes' } = Astro.props;
---

{
  faqs.length > 0 && (
    <section class="section">
      <div class="container-page max-w-3xl">
        <span class="kicker">FAQ</span>
        <h2 class="mt-2 text-2xl sm:text-3xl">{title}</h2>
        <div class="mt-6 divide-y divide-line rounded-md border border-line">
          {faqs.map((faq, i) => (
            <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-start gap-4 font-semibold text-ink">
                <span class="font-mono text-xs text-teal">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1">{faq.pregunta}</span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-5 w-5 shrink-0 text-ink-faint transition-transform group-open:rotate-180"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <p class="mt-3 pl-8 leading-relaxed text-ink-soft">{faq.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
