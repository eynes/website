---
import PartnerBadge from '../shared/PartnerBadge.astro';
import { withBase } from '../../lib/url';

interface CtaLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  showPartnerBadge?: boolean;
  primaryCta?: CtaLink;
  secondaryCta?: CtaLink;
  imagePlaceholder?: string;
  compact?: boolean;
  understated?: boolean;
}

const {
  title,
  subtitle,
  showPartnerBadge = true,
  primaryCta,
  secondaryCta,
  imagePlaceholder,
  compact = false,
  understated = false,
} = Astro.props;

const isExternalLink = (href: string) => /^[a-z][a-z0-9+.-]*:/i.test(href);
---

<section class:list={['hero relative border-b border-line', compact && 'hero-compact', understated && 'hero-understated']}>
  <div
    class:list={[
      'hero-layout container-page relative grid items-end gap-10',
      imagePlaceholder ? 'lg:grid-cols-[1.1fr_0.9fr]' : '',
    ]}
  >
    <div>
      {showPartnerBadge && (
        <div class="enter enter-1">
          <PartnerBadge />
        </div>
      )}
      <h1 class:list={['hero-title enter enter-2', showPartnerBadge && 'mt-8']}>
        {title}
      </h1>
      <slot name="details" />
      {(subtitle || primaryCta || secondaryCta) && <div class="hero-bottom">
        {subtitle && (
          <p class="hero-description enter enter-3 text-ink-soft">
            {subtitle}
          </p>
        )}
        {
          (primaryCta || secondaryCta) && (
            <div class="hero-actions enter enter-4 flex flex-wrap gap-3">
              {primaryCta && (
                <a
                  href={withBase(primaryCta.href)}
                  class="btn-primary"
                  {...isExternalLink(primaryCta.href) && { target: '_blank', rel: 'noopener noreferrer' }}
                >
                  {primaryCta.label}
                </a>
              )}
              {secondaryCta && (
                <a
                  href={withBase(secondaryCta.href)}
                  class="btn-outline"
                  {...isExternalLink(secondaryCta.href) && { target: '_blank', rel: 'noopener noreferrer' }}
                >
                  {secondaryCta.label}
                </a>
              )}
            </div>
          )
        }
      </div>}
    </div>
    {
      imagePlaceholder && (
        <div class="enter enter-3 flex aspect-[4/3] items-center justify-center border p-6 text-center font-mono text-xs uppercase tracking-wide text-ink-faint" style="border-color: var(--color-line)">
          {imagePlaceholder}
        </div>
      )
    }
  </div>
</section>
