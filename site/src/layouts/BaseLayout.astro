---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/nav/Footer.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import WhatsAppButton from '../components/forms/WhatsAppButton.astro';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogImage, jsonLd = [], noindex = false } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = new URL(withBase(ogImage || '/og-default.png'), Astro.site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-inter" preload />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/favicon-32x32.png')} sizes="32x32" />
    <link rel="icon" type="image/png" href={withBase('/favicon-16x16.png')} sizes="16x16" />
    <link rel="icon" type="image/png" href={withBase('/icon.png')} sizes="512x512" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Eynes" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    {jsonLd.map((schema) => <JsonLd schema={schema} />)}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido principal</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton variant="floating" />
    <script>
      const revealEls = document.querySelectorAll('.reveal');
      const showAll = () => revealEls.forEach((el) => el.classList.add('is-visible'));

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        showAll();
      } else {
        try {
          document.documentElement.classList.add('js-motion');
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );
          revealEls.forEach((el) => io.observe(el));
        } catch {
          showAll();
        }
      }
    </script>
  </body>
</html>
